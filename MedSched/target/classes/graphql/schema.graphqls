input CreateUpdateAppointmentRequest {
    id: ID
    patientId: ID!
    doctorId: ID!
    appointmentDate: String!
}

type CreateUpdateAppointmentResponse {
    id: ID!
    patient: User!
    doctor: User!
    appointmentDate: String!
    appointmentStatus: AppointmentStatus!
}

input CreateUpdateUserRequest {
    id: ID
    name: String!
    surname: String!
    email: String!
    userType: UserType!
}

type CreateUpdateUserResponse {
    id: ID!
    name: String!
    surname: String!
    email: String!
    userType: UserType!
}

type User {
    id: ID!
    name: String!
    surname: String!
    email: String!
    userType: UserType!
}

enum UserType {
    DOCTOR,
    NURSE,
    PATIENT
}

enum AppointmentStatus {
    CREATED,
    EDITED,
    CANCELLED
}

type Appointment {
    id: ID!
    patient: User!
    doctor: User!
    appointmentDate: String!
    status: AppointmentStatus!
    createdAt: String!
    lastUpdatedAt: String!
}

extend type Query {
    getAllUsers: [User!]!
    getAllUsersByUserType(userType: UserType!): [User!]!
    getUserById(userId: ID!): User!
    getAppointmentsByDate(appointmentDate: String!): [Appointment!]!
    getAppointmentsByPatientId(patientId: ID!): [Appointment!]!
    getAppointmentsByDoctorId(doctorId: ID!): [Appointment!]!
    getAppointmentById(appointmentId: ID!): Appointment!
    getAllAppointments: [Appointment!]!
}

extend type Mutation {
    createUser(request: CreateUpdateUserRequest!): CreateUpdateUserResponse!
    updateUser(request: CreateUpdateUserRequest!): CreateUpdateUserResponse!
    deleteUser(userId: ID!): CreateUpdateUserResponse
    createAppointment(request: CreateUpdateAppointmentRequest): CreateUpdateAppointmentResponse!
    updateAppointment(request: CreateUpdateAppointmentRequest): CreateUpdateAppointmentResponse!
    cancelAppointment(appointmentId: ID!): CreateUpdateAppointmentResponse
}